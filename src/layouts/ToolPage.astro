---
// A calculator page in GOV.UK's content pattern (GOLD-STANDARD.md §6: a reading column, no hero picture, no buttons
// above the answer, no motion): breadcrumb, heading, one-sentence lead, the calculator, then how it is worked out and
// the sources, in prose.
import Base from "./Base.astro"
import Breadcrumb from "../components/Breadcrumb.astro"
import { brand, site } from "../data/brand"

interface Props { title: string; description: string; h1: string; lead: string; crumb: string; path: string }
const { title, description, h1, lead, crumb, path } = Astro.props
const jsonLd = [
  { "@context": "https://schema.org", "@type": "WebApplication", name: h1, url: `${site.url}${path}`, applicationCategory: "UtilitiesApplication", operatingSystem: "Any (web browser)", isAccessibleForFree: true, offers: { "@type": "Offer", price: "0", priceCurrency: "USD" }, publisher: { "@type": "Organization", name: brand.legalName, url: brand.companyUrl } },
  { "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: [{ "@type": "ListItem", position: 1, name: site.name, item: `${site.url}/` }, { "@type": "ListItem", position: 2, name: h1, item: `${site.url}${path}` }] },
]
---
<Base title={title} description={description} jsonLd={jsonLd}>
  <article class="mx-auto max-w-page px-gutter pt-8">
    <Breadcrumb trail={[{ href: "/", label: "Calculators" }, { label: crumb }]} />
    <h1 class="heading mt-6 max-w-measure text-3xl text-gray-12 sm:text-4xl">{h1}</h1>
    <p class="mt-4 max-w-measure text-lg text-gray-11">{lead}</p>
    <slot name="calculator" />
    <div class="prose prose-brand"><slot /></div>
  </article>
</Base>
