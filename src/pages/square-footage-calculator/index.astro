---
// A tool page in GOV.UK's content pattern (GOLD-STANDARD.md §6). Every number on it comes from a source named on it.
import Base from "../../layouts/Base.astro"
import Breadcrumb from "../../components/Breadcrumb.astro"
import AreaCalculator from "../../components/AreaCalculator.astro"
import { brand, site } from "../../data/brand"

const title = "Square footage calculator: rooms, lots and odd shapes"
const description = "Square feet, square yards, square meters and acres for rectangles, circles, triangles and trapezoids, with cut-outs taken away and an optional cost, formulas shown."
const jsonLd = [
  { "@context": "https://schema.org", "@type": "WebApplication", name: "Square footage calculator", url: `${site.url}/square-footage-calculator/`, applicationCategory: "UtilitiesApplication", operatingSystem: "Any (web browser)", isAccessibleForFree: true, offers: { "@type": "Offer", price: "0", priceCurrency: "USD" }, publisher: { "@type": "Organization", name: brand.legalName, url: brand.companyUrl } },
  { "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: [{ "@type": "ListItem", position: 1, name: site.name, item: `${site.url}/` }, { "@type": "ListItem", position: 2, name: "Square footage calculator", item: `${site.url}/square-footage-calculator/` }] },
]
---
<Base title={title} description={description} jsonLd={jsonLd}>
  <article class="mx-auto max-w-page px-gutter pt-8">
    <Breadcrumb trail={[{ href: "/", label: "Calculators" }, { label: "Square footage" }]} />
    <h1 class="heading mt-6 max-w-measure text-3xl text-gray-12 sm:text-4xl">Square footage</h1>
    <p class="mt-4 max-w-measure text-lg text-gray-11">The area of a room, a floor, a lot or an odd shape in square feet, square yards, square meters and acres.</p>

    <AreaCalculator />

    <div class="prose prose-brand">
      <h2 id="how">How the numbers are worked out</h2>
      <ul>
        <li><strong>Rectangle or square:</strong> length × width.</li>
        <li><strong>Circle:</strong> π × (diameter ÷ 2)².</li>
        <li><strong>Triangle:</strong> base × height ÷ 2, where the height is measured square to the base.</li>
        <li><strong>Trapezoid:</strong> (side a + side b) ÷ 2 × height, where sides a and b are the two parallel sides.</li>
        <li>An L-shaped or odd room is split into rectangles and other shapes, each added as its own part. A cut-out, such as a kitchen island, is a part that is taken away.</li>
      </ul>
      <h2 id="units">Units</h2>
      <ul>
        <li>1 square yard = 9 square feet.</li>
        <li>1 square foot = 0.09290304 square meters exactly, since 1 foot = 0.3048 m.</li>
        <li>1 acre = 43,560 square feet.</li>
      </ul>
      <h2 id="sources">Sources</h2>
      <ul>
        <li>NIST, <a href="https://www.nist.gov/pml/special-publication-811">Guide for the Use of the International System of Units (SP 811)</a>: the exact foot.</li>
        <li>NIST, <a href="https://www.nist.gov/pml/owm/publications/nist-handbooks/handbook-44">Handbook 44, Appendix C</a>: the acre.</li>
      </ul>
    </div>
  </article>
</Base>
