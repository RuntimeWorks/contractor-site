---
// Home: a list of the calculators, in GOV.UK's content pattern for a tool site (GOLD-STANDARD.md §6). The page's job
// is to get a contractor to the right tool in one step, so the tools are the first thing under the heading.
import Base from "../layouts/Base.astro"
import { brand, site, tools } from "../data/brand"

const jsonLd = { "@context": "https://schema.org", "@type": "WebSite", name: site.name, url: `${site.url}/`, description: site.description, publisher: { "@type": "Organization", name: brand.legalName, url: brand.companyUrl } }
---
<Base title={`${site.name}: concrete and square footage`} description={site.description} jsonLd={jsonLd}>
  <section class="mx-auto max-w-page px-gutter pt-12" aria-labelledby="h1">
    <h1 id="h1" class="heading max-w-measure text-3xl text-gray-12 sm:text-4xl">Calculators for contractors</h1>
    <p class="mt-4 max-w-measure text-lg text-gray-11">Free, with no account. Each one shows its formula and where its numbers come from.</p>
    <ul class="mt-10 grid gap-5 sm:grid-cols-2">
      {tools.map((t) => (
        <li class="card relative p-6 transition-shadow duration-fast ease-productive hover:shadow-card-hover">
          <h2 class="heading text-xl text-gray-12"><a href={t.href} class="no-underline after:absolute after:inset-0 after:rounded-card">{t.name}</a></h2>
          <p class="mt-2 text-gray-11">{t.summary}</p>
        </li>
      ))}
    </ul>
  </section>
</Base>
