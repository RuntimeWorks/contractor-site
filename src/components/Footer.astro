---
// Footer in boldsand.com's shape (~/boldsand-policies Footer.astro): ink ground, the inverse mark and wordmark,
// column headings, links in sand, the company line under it.
import Mark from "./Mark.astro"
import { brand, site, tools } from "../data/brand"

const year = new Date().getFullYear()
const columns = [
  { title: "Calculators", links: tools.map((t) => ({ href: t.href, label: t.name })) },
  { title: "This site", links: [{ href: "/about/", label: "About and sources" }, { href: "/privacy/", label: "Privacy" }] },
]
---
<footer data-site class="mt-section bg-ink text-on-harbour-2">
  <div class="mx-auto max-w-page px-gutter pt-14 pb-[calc(2.25rem+env(safe-area-inset-bottom))]">
    <div class="grid gap-10 sm:grid-cols-[1.4fr_repeat(2,minmax(0,1fr))]">
      <div>
        <a href="/" class="inline-flex min-h-11 items-center gap-2.5 text-on-harbour no-underline">
          <Mark class="size-[26px]" inverse />
          <span class="wordmark text-base">{brand.name}</span>
        </a>
        <p class="mt-3 max-w-xs text-sm">{site.name}: free, with every formula and source shown. Made in Charlottetown, Prince Edward Island.</p>
      </div>
      {columns.map((c) => (
        <nav aria-label={c.title}>
          <h2 class="label text-on-harbour-2">{c.title}</h2>
          <ul class="mt-3 grid gap-1 text-sm">
            {c.links.map((l) => (
              <li><a href={l.href} class="inline-flex min-h-8 items-center text-on-harbour no-underline hover:underline">{l.label}</a></li>
            ))}
          </ul>
        </nav>
      ))}
    </div>
    <div class="mt-12 flex flex-wrap justify-between gap-x-8 gap-y-2 text-sm">
      <p>© {year} <a href={brand.companyUrl} class="text-on-harbour underline-offset-4 hover:underline">{brand.legalName}</a></p>
      <p>{brand.address.street}, {brand.address.city}, {brand.address.region} {brand.address.postal}, Canada</p>
    </div>
  </div>
</footer>
